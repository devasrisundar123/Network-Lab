int findComplement(int num) {
    int bin[32];
    int len = 0;
    while (num > 0) {
        int rem = num % 2;
        bin[len] = rem; 
        len++;         
        num = num / 2;
    }
    for (int i = 0; i < len; i++) {
        if (bin[i] == 1) {
            bin[i] = 0;
        } else {
            bin[i] = 1;
        }
    }
    int result = 0;
    for (int i = len - 1; i >= 0; i--) {
        result = result * 2 + bin[i];
    }
    return result;
}
